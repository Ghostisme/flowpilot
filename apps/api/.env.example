# Same six variables used by Agent Studio. Copy their values from the Agent
# Studio Vercel backend project; FlowPilot creates only flowpilot_* tables.
PERSISTENCE_DRIVER=mysql
FLOWPILOT_TABLE_PREFIX=flowpilot_
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=defaultdb
MYSQL_SSL=true
# Optional PEM text. Use \n for line breaks. Existing Agent Studio values work
# without this because MYSQL_SSL=true still enables an encrypted connection.
MYSQL_SSL_CA=
MYSQL_POOL_SIZE=2

WORKFLOW_DRIVER=n8n
N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/flowpilot-lead-intake
N8N_INTERNAL_BASE_URL=
N8N_EVENT_SECRET=replace-with-the-same-long-random-value-used-by-n8n
N8N_WEBHOOK_TIMEOUT_MS=10000

CORS_ORIGINS=https://YOUR-FLOWPILOT-WEB.vercel.app
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
