# Browser-facing API URL used by the Next.js app.
NEXT_PUBLIC_API_BASE=http://localhost:3001/api
# Vercel serverless deployments should use polling because a new function
# instance may receive each request. Local Docker can keep the default SSE.
NEXT_PUBLIC_EVENT_TRANSPORT=sse

# API runtime.
PORT=3001
CORS_ORIGINS=http://localhost:3000
WORKFLOW_DRIVER=simulator
SIMULATOR_NODE_DELAY_MS=130
N8N_WEBHOOK_URL=http://localhost:5678/webhook/flowpilot-lead-intake
# Optional internal origin used by the API to resume n8n Wait nodes in Docker.
N8N_INTERNAL_BASE_URL=
N8N_EVENT_SECRET=flowpilot-local-secret
N8N_WEBHOOK_TIMEOUT_MS=10000

# Persistence. Local Compose uses PostgreSQL. Vercel can reuse Agent Studio's
# managed MySQL connection by setting PERSISTENCE_DRIVER=mysql and copying the
# same MYSQL_* values. FlowPilot uses only flowpilot_* tables.
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgresql://flowpilot:flowpilot@localhost:5432/flowpilot
FLOWPILOT_TABLE_PREFIX=flowpilot_
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=defaultdb
MYSQL_SSL=true
MYSQL_SSL_CA=
MYSQL_POOL_SIZE=2

# Optional AI adapter. Without this key the demo uses a deterministic qualifier.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
