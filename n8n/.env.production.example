N8N_HOST=YOUR-N8N-HOST
N8N_PORT=5678
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/
N8N_EDITOR_BASE_URL=https://YOUR-N8N-HOST/
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai
N8N_ENCRYPTION_KEY=replace-with-a-long-random-stable-value
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_UNVERIFIED_PACKAGES_ENABLED=false
N8N_CONCURRENCY_PRODUCTION_LIMIT=1
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# n8n supports PostgreSQL, not MySQL, for its internal database. These values
# can come from a separate Aiven Free PostgreSQL service.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=YOUR-AIVEN-POSTGRES-HOST
DB_POSTGRESDB_PORT=YOUR-AIVEN-POSTGRES-PORT
DB_POSTGRESDB_DATABASE=defaultdb
DB_POSTGRESDB_USER=avnadmin
DB_POSTGRESDB_PASSWORD=YOUR-AIVEN-POSTGRES-PASSWORD
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_POOL_SIZE=2
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

FLOWPILOT_API_URL=https://YOUR-FLOWPILOT-API.vercel.app
N8N_EVENT_SECRET=replace-with-the-same-value-used-by-flowpilot-api
