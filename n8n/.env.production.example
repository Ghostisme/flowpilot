N8N_HOST=YOUR-N8N-HOST
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/
N8N_EDITOR_BASE_URL=https://YOUR-N8N-HOST/
GENERIC_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai
N8N_ENCRYPTION_KEY=replace-with-a-long-random-stable-value
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_UNVERIFIED_PACKAGES_ENABLED=false
FLOWPILOT_API_URL=https://YOUR-FLOWPILOT-API.vercel.app
N8N_EVENT_SECRET=replace-with-the-same-value-used-by-flowpilot-api
